# Python pycache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environments & Embedded Runtimes
backend/venv/
backend/python/
venv/
.env

# Large Assets, Binaries & Pretrained Weights
backend/weights/**
!backend/weights/**/
!backend/weights/**/*.gitkeep
backend/vfms/**
!backend/vfms/**/
!backend/vfms/**/*.gitkeep
backend/ffmpeg/
weights/**
vfms/**
*.tar.zst
*.tar
*.zst
*.zip
*.pt
*.npz

# Outputs, User Data & Temporary Files
out*/
tmp/
Projects/
logs/
config/
backend/config/
*.log
*.mov
*.mp4
*.exr
*.png
*.jpg
*.jpeg
*.f16
*.f32

# Whitelist UI assets, icons, themes, fonts, sounds
!backend/ui/theme/**
!backend/ui/theme/**/*.png
!backend/ui/theme/**/*.jpg
!backend/ui/theme/**/*.jpeg
!backend/ui/theme/**/*.ico
!backend/ui/theme/**/*.icns
!backend/ui/theme/**/*.svg
!backend/ui/theme/fonts/**
!backend/ui/sounds/**
backend/ui/**/__pycache__/
backend/ui/**/*.pyc

# Rust build target
rust_core/target/
backend/rust_core/target/
target/

# Local / studio-specific files
path_mappings.json
.claude/
